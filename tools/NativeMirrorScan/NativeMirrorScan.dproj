        <DCCReference Include="..\..\src\Dumper\NativeMirror.Dumper.Reconstructor.pas"/>
        <DCCReference Include="..\..\src\Dumper\NativeMirror.Dumper.Reports.pas"/>
        <DCCReference Include="..\..\src\Layer\NativeMirror.Layer.Lde.pas"/>
        <DCCReference Include="..\..\src\Layer\NativeMirror.Layer.NativeAsm.pas"/>
        <DCCReference Include="..\..\src\Layer\NativeMirror.Layer.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Enumeration.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.MiniDump.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Paths.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Process.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Reflection.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Symbols.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Syscalls.pas"/>
        <DCCReference Include="..\..\src\Platform\NativeMirror.Platform.Threads.pas"/>
        <DCCReference Include="..\..\src\Scanner\NativeMirror.Scanner.Artefacts.pas"/>
        <DCCReference Include="..\..\src\Scanner\NativeMirror.Scanner.Code.pas"/>
        <DCCReference Include="..\..\src\Scanner\NativeMirror.Scanner.Headers.pas"/>
        <DCCReference Include="..\..\src\Scanner\NativeMirror.Scanner.HookTargets.pas"/>
        <DCCReference Include="..\..\src\Scanner\NativeMirror.Scanner.IAT.pas"/>
